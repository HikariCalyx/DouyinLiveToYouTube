# Copy to /etc/douyin-live-to-youtube.env and chmod 600.
# Generate the key with: python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=replace-me-with-a-random-50-character-secret
DJANGO_DEBUG=0

# CloudFront distribution domain + any custom domain you attach to it.
DJANGO_ALLOWED_HOSTS=d111111abcdef8.cloudfront.net,live.example.com

# Must include the scheme. Missing entries cause "CSRF verification failed" on POST.
DJANGO_CSRF_TRUSTED_ORIGINS=https://d111111abcdef8.cloudfront.net,https://live.example.com

# Secure cookies (viewer is always HTTPS through CloudFront).
DJANGO_HTTPS=1
# CloudFront already redirects viewers, so Django stays out of it.
DJANGO_SECURE_SSL_REDIRECT=0
# Optional HSTS; start with a small value.
DJANGO_SECURE_HSTS_SECONDS=0

DJANGO_TIME_ZONE=Asia/Shanghai
DJANGO_LOG_LEVEL=INFO

# Store state outside the release directory so deploys do not wipe it.
DJANGO_DB_PATH=/var/lib/douyin-live/db.sqlite3
DJANGO_LOG_DIR=/var/log/douyin-live

# Optional: hide the Django admin behind a non-default path.
# DJANGO_ADMIN_PATH=ops-console/
