[Unit]
Description=Douyin -> YouTube dashboard (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/douyin-live-to-youtube
EnvironmentFile=/etc/douyin-live-to-youtube.env
ExecStart=/opt/douyin-live-to-youtube/.venv/bin/gunicorn dashboard.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --threads 4 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
